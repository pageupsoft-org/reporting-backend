# Copy to .env (never commit it) and fill in. Real environment variables take precedence.
# Generate the three secrets with:  python scripts/generate_secrets.py

REPORTING_ENV=production

# Public origin users and embeds reach the app on (https required except for localhost).
REPORTING_PUBLIC_URL=https://reports.example.com

# The app's own database (users, connections, snapshots, reports). PostgreSQL recommended.
REPORTING_APP_DB_URL=postgresql+psycopg://reporting:CHANGE_ME@db-host:5432/reporting

# Secrets — keep them in a secret manager. Losing REPORTING_MASTER_KEY makes saved
# connection passwords unrecoverable; changing REPORTING_EMBED_KEY invalidates embed secrets.
REPORTING_MASTER_KEY=
REPORTING_JWT_SECRET=
REPORTING_EMBED_KEY=

# First administrator, used only when there are no users yet.
REPORTING_ADMIN_USER=admin
REPORTING_ADMIN_PASSWORD=

# Front end hosted separately (Vercel): API-only server, embed page fetched from PUBLIC_URL.
# REPORTING_SERVE_FRONTEND=false

# Optional
# REDIS_URL=redis://redis:6379/0        # shared result cache across workers/servers
# POSTGRES_PASSWORD=                    # docker compose: password for the bundled PostgreSQL
# REPORTING_CACHE_TTL=300
# REPORTING_SESSION_TTL=43200           # seconds a sign-in lasts
# REPORTING_CORS_ORIGINS=               # only if the UI is served from another origin
# REPORTING_API_DOCS=false              # true exposes /api/docs
# REPORTING_MAX_BODY_BYTES=8388608
# REPORTING_LOGIN_ATTEMPTS=10           # per IP and username, per minute
# REPORTING_WORKERS=4                   # server processes (production scripts)
# REPORTING_LOG_LEVEL=info
